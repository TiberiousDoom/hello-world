// The game's site on Cloudflare (D-188): a Worker that only serves the built game (dist/), with no code of its own.
// CI deploys it from master (.github/workflows/deploy.yml). Until playnestfall.com points here, it is only on its
// workers.dev address; GitHub Pages keeps serving playnestfall.com.
{
  "$schema": "../relay/node_modules/wrangler/config-schema.json",
  "name": "nestfall",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
}
