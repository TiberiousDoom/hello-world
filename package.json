{
  "name": "foundry-front",
  "private": true,
  "version": "0.86.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc --noEmit -p server && esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs",
    "server": "npm run build:server && node dist-server/server.mjs",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"server/**/*.ts\" \"e2e/**/*.ts\" \"*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"server/**/*.ts\" \"e2e/**/*.ts\" \"*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
