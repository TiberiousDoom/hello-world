// The studio's site, box47games.com (D-188): a Worker that only serves studio/public/. CI deploys it from master.
{
  "$schema": "../relay/node_modules/wrangler/config-schema.json",
  "name": "box47games",
  "compatibility_date": "2026-10-01",
  // Served only at its own domain since the switch (D-192): no second copy at a workers.dev address.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
}
