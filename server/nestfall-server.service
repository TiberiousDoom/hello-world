# The dedicated server as a systemd service (D-084): starts at boot, restarts if it stops.
# Install: see server/README.md. Paths assume the repo is cloned to /home/nestfall/hello-world.
[Unit]
Description=Nestfall dedicated co-op server
After=network-online.target
Wants=network-online.target

[Service]
User=nestfall
WorkingDirectory=/home/nestfall/hello-world
Environment=NESTFALL_DATA=/home/nestfall/server-data
# Environment=NESTFALL_ROOM=CREW42
# Environment="NESTFALL_NAME=Stephen's server"
# Environment=NESTFALL_MAX_ROOMS=4
ExecStart=/usr/bin/node dist-server/server.mjs
Restart=always
RestartSec=5
# Time to save before being stopped.
TimeoutStopSec=20

# It talks to the internet and reads what players send, so it gets only what it needs: no new privileges,
# a read-only system, and only its data folder writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nestfall/server-data
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
